# --- Frontend (port 3000) ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# fixtures | payload
CONTENT_SOURCE=fixtures

# Backend Payload API
API_URL=http://127.0.0.1:3001
# API key пользователя Payload (Users → API Keys) для записи из /admin
PAYLOAD_API_KEY=

# Кастомная админка /admin (обязательны; без них логин fail-closed)
ADMIN_EMAIL=admin@citata-pr.ru
ADMIN_PASSWORD=change-me-admin-password
# HMAC secret for signed session cookie (≥16 chars). Required in production.
ADMIN_SESSION_SECRET=change-me-admin-session-secret-32chars

# Short-lived case preview tokens (?preview=). Keep separate from revalidate.
PREVIEW_SECRET=change-me-preview-secret-32chars

# Webhook revalidate only (backend → POST /api/revalidate). Never put in preview URLs.
REVALIDATE_SECRET=change-me-revalidate-secret
