# --- Backend Payload (port 3001) ---
NODE_ENV=development
PORT=3001

PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://citata:password@127.0.0.1:5432/citata_dev

# Публичный сайт — для on-demand revalidate
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-revalidate-secret

# S3 Рег.облако (optional; без S3 — локальный media)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=1
S3_PUBLIC_BASE_URL=

NEXT_PUBLIC_SERVER_URL=http://localhost:3001
